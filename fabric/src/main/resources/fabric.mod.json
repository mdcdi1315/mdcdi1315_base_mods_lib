{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"icon": "${mod_id}-icon.png",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${homepage}",
		"sources": "${sources}",
		"issues": "${issues}"
	},
	"custom": {
		"modmenu": {
			"badges": [ "library" ],
			"update_checker": false,
			"links": {
				"modmenu.github_releases": "https://github.com/mdcdi1315/mdcdi1315_base_mods_lib/releases"
			}
		}
	},

	"license": "${license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"${group}.basemodslib.fabric.FabricModEntryPoint"
		],
		"client": [
			"${group}.basemodslib.fabric.FabricModClientEntryPoint"
		],
		"modmenu": [
			"${group}.basemodslib.integration.modmenu.ModMenuEntryPoint"
		],
		"fabric-datagen": []
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"suggests": {
		"modmenu": ">=${mod_menu_version}"
	},
	"depends": {
		"java": ">=${java_version}",
		"minecraft": "=${minecraft_version}",
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-api": ">=${fabric_version}"
	}
}